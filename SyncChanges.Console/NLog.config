<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.nlog-project.org/schemas/NLog.xsd NLog.xsd"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Off" internalLogFile="c:\temp\nlog-internal.log">
  <!--
  See https://github.com/nlog/nlog/wiki/Configuration-file
  for information on customizing logging rules and outputs.
   -->
  <!--
  The log file is written to the folder of the executable, or, for the dotnet tool, to a SyncChanges folder in
  the user's local application data (LogDirectory). An NLog.config in the current folder replaces this one.
  -->
  <targets>
    <!--
    add your targets here
    See https://github.com/nlog/NLog/wiki/Targets for possible targets.
    See https://github.com/nlog/NLog/wiki/Layout-Renderers for the possible layout renderers.
    -->
    <target xsi:type="ColoredConsole"
            name="console" encoding="utf-8"
            useDefaultRowHighlightingRules="true"
            layout="${longdate}|${level:uppercase=true}|${message} ${exception:format=toString,Data}" />
    <target xsi:type="File" name="file" fileName="${gdc:item=LogDirectory:whenEmpty=${basedir}}/log.txt"
            archiveFileName="${gdc:item=LogDirectory:whenEmpty=${basedir}}/log.txt"
            archiveEvery="Day"
			archiveSuffixFormat=".{1:yyyyMMdd}"
            maxArchiveFiles="10"
            encoding="utf-8"
            layout="${longdate}|${level:uppercase=true}|${message} ${exception:format=toString,Data}" />
  </targets>
  <rules>
    <logger name="*" minlevel="Debug" writeTo="console" />
    <logger name="*" minlevel="Debug" writeTo="file" />
  </rules>
</nlog>
